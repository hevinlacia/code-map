# Local backend binding
CODE_MAP_HOST=127.0.0.1
CODE_MAP_PORT=18765

# Local cache/index directory. Keep generated index data out of git.
CODE_MAP_DATA_DIR=./data

# Optional default workspace shown in the UI.
CODE_MAP_DEFAULT_WORKSPACE=/path/to/workspace

# Built frontend assets served by the backend in systemd mode.
CODE_MAP_FRONTEND_DIR=/home/hevin/Developer/tools/code-map/frontend/dist

# Disabled by default so UI toggles cannot trigger filesystem writes until explicitly allowed.
CODE_MAP_ENABLE_WRITE_ACTIONS=false
